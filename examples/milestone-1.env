# Demonstration configuration for milestone 1.
[default]
decimal_places = 3
string_truncate = 80
output_format = table
timing = true

[trino-dev]
engine = trino
url = https://trino.example.com
user = analyst
token = ${QCLI_DEMO_TOKEN}
catalog = hive
schema = analytics
decimal_places = 10

[databricks-dev]
engine = databricks
host = https://dbc-example.cloud.databricks.com
http_path = /sql/1.0/warehouses/abc123
token = ${QCLI_DEMO_TOKEN}
catalog = main
schema = default

[snowflake-prod]
engine = snowflake
account = organization-account
user = analyst
password = ${QCLI_DEMO_TOKEN}
warehouse = COMPUTE_WH
database = REPORTING
schema = PUBLIC
role = ANALYST
